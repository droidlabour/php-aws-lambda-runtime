#!/usr/bin/env php
<?php

[$handlerFile, $handlerFunction] = explode('.', getenv('_HANDLER'), 2);
require getenv('LAMBDA_TASK_ROOT') . '/' . $handlerFile . '.php';

$runtimeApi = getenv('AWS_LAMBDA_RUNTIME_API');

while (true) {
    $ch = curl_init("http://{$runtimeApi}/2018-06-01/runtime/invocation/next");
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_HEADER, true);
    $response = curl_exec($ch);
    $headerSize = curl_getinfo($ch, CURLINFO_HEADER_SIZE);
    curl_close($ch);

    $headers = substr($response, 0, $headerSize);
    $body = substr($response, $headerSize);

    preg_match('/^Lambda-Runtime-Aws-Request-Id:\s*(.*)$/mi', $headers, $matches);
    $requestId = trim($matches[1]);

    // Expose the invocation's request id to the app. A custom runtime does
    // not get the per-request context object the managed runtimes hand your
    // handler, so this is the only place it exists - useful for tagging log
    // lines so you can pull one invocation's output back out of CloudWatch.
    putenv("AWS_LAMBDA_REQUEST_ID={$requestId}");
    $_SERVER['AWS_LAMBDA_REQUEST_ID'] = $requestId;

    // Echo this back on the response/error so Lambda can tell we are answering
    // the invocation we were actually handed (cross-wiring protection).
    $invocationId = null;
    if (preg_match('/^Lambda-Runtime-Invocation-Id:\s*(.*)$/mi', $headers, $invocationMatches)) {
        $invocationId = trim($invocationMatches[1]);
    }

    if (preg_match('/^Lambda-Runtime-Trace-Id:\s*(.*)$/mi', $headers, $traceMatches)) {
        putenv('_X_AMZN_TRACE_ID=' . trim($traceMatches[1]));
    } else {
        putenv('_X_AMZN_TRACE_ID');
    }

    try {
        $result = call_user_func($handlerFunction, json_decode($body, true));

        $ch = curl_init("http://{$runtimeApi}/2018-06-01/runtime/invocation/{$requestId}/response");
        curl_setopt($ch, CURLOPT_POST, true);
        curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($result));
        if ($invocationId !== null) {
            curl_setopt($ch, CURLOPT_HTTPHEADER, ["Lambda-Runtime-Invocation-Id: {$invocationId}"]);
        }
        curl_exec($ch);
        curl_close($ch);
    } catch (\Throwable $e) {
        $errorBody = json_encode([
            'errorMessage' => $e->getMessage(),
            'errorType' => get_class($e),
            'stackTrace' => $e->getTrace(),
        ]);

        $ch = curl_init("http://{$runtimeApi}/2018-06-01/runtime/invocation/{$requestId}/error");
        curl_setopt($ch, CURLOPT_POST, true);
        curl_setopt($ch, CURLOPT_POSTFIELDS, $errorBody);
        if ($invocationId !== null) {
            curl_setopt($ch, CURLOPT_HTTPHEADER, ["Lambda-Runtime-Invocation-Id: {$invocationId}"]);
        }
        curl_exec($ch);
        curl_close($ch);
    }
}
